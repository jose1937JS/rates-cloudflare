{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rates-api",
  "main": "src/index.ts",
  "compatibility_date": "2024-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rates-db",
      "database_id": "9833f98c-b514-4236-9845-6edab29ffc40"
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issue_detection": {
      "enabled": false
    }
  },
  "triggers": {
    "crons": [
      "0 10 * * 1-5",  // 6:00 AM hora Venezuela (UTC-4), lunes a viernes -> Scraping BCV (1 vez al día)
      "0 */4 * * *"    // Cada 4 horas todos los días -> Consulta Yadio USDT
    ]
  }
}
